#!/usr/bin/env python3
"""Create the three-value user configuration outside the repository."""

from __future__ import annotations

import argparse
import json
import os
from pathlib import Path
import secrets
import shlex
import shutil
import subprocess
from urllib.parse import urlsplit


CONFIG_DIR = Path(
    os.environ.get(
        "IOS_ASSISTANT_CONFIG_DIR",
        Path.home() / ".config" / "codex-ios-assistant",
    )
).expanduser()
CONFIG_FILE = CONFIG_DIR / "config.env"


def existing_values() -> dict[str, str]:
    values: dict[str, str] = {}
    if not CONFIG_FILE.is_file():
        return values
    for raw_line in CONFIG_FILE.read_text().splitlines():
        line = raw_line.strip()
        if not line or line.startswith("#") or "=" not in line:
            continue
        name, raw_value = line.split("=", 1)
        parsed = shlex.split(raw_value.strip())
        values[name.strip()] = parsed[0] if parsed else ""
    return values


def prompt(label: str, current: str = "") -> str:
    suffix = f" [{current}]" if current else ""
    value = input(f"{label}{suffix}: ").strip()
    return value or current


def quote(value: str) -> str:
    return '"' + value.replace("\\", "\\\\").replace('"', '\\"') + '"'


def tailscale_origin() -> str:
    tailscale = shutil.which("tailscale")
    if not tailscale:
        return ""
    result = subprocess.run(
        [tailscale, "status", "--json"],
        check=False,
        text=True,
        capture_output=True,
    )
    if result.returncode != 0:
        return ""
    try:
        status = json.loads(result.stdout)
    except json.JSONDecodeError:
        return ""
    dns_name = str(status.get("Self", {}).get("DNSName", "")).rstrip(".")
    return f"https://{dns_name}" if dns_name else ""


def main() -> int:
    parser = argparse.ArgumentParser(description="Configure codex-ios-assistant")
    parser.add_argument("--target", help="your own iMessage email address or phone number")
    parser.add_argument("--url", help="stable HTTPS receiver origin")
    parser.add_argument("--force-token", action="store_true", help="rotate the receiver token")
    args = parser.parse_args()

    current = existing_values()
    target = args.target or prompt(
        "iMessage address that reaches this iPhone", current.get("IPHONE_MSG_TARGET", "")
    )
    public_url = args.url or tailscale_origin() or current.get("IPHONE_PUBLIC_URL", "")
    if not public_url:
        public_url = prompt(
            "Tailscale HTTPS origin (for example https://mac-name.tailnet.ts.net)"
        )
    public_url = public_url.rstrip("/")
    parsed_url = urlsplit(public_url)
    if parsed_url.scheme != "https" or not parsed_url.hostname or parsed_url.path not in {"", "/"}:
        parser.error("--url must be an HTTPS origin without a path")
    if not target or any(character in target for character in "\r\n"):
        parser.error("--target must be a non-empty, single-line iMessage address")

    token = current.get("IPHONE_RECEIVER_TOKEN", "")
    if args.force_token or len(token) < 32:
        token = secrets.token_urlsafe(32)

    CONFIG_DIR.mkdir(parents=True, exist_ok=True)
    os.chmod(CONFIG_DIR, 0o700)
    contents = (
        "# Generated by codex-ios-assistant/scripts/configure. Keep this file private.\n"
        f"IPHONE_MSG_TARGET={quote(target)}\n"
        f"IPHONE_PUBLIC_URL={quote(public_url)}\n"
        f"IPHONE_RECEIVER_TOKEN={quote(token)}\n"
    )
    temporary = CONFIG_FILE.with_suffix(".env.tmp")
    temporary.write_text(contents)
    os.chmod(temporary, 0o600)
    os.replace(temporary, CONFIG_FILE)
    print(f"Wrote private configuration to {CONFIG_FILE}")
    print("The receiver token was generated automatically and was not printed.")
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
