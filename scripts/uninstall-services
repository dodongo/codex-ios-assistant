#!/usr/bin/env python3
"""Stop codex-ios-assistant LaunchAgents and move their plists to Trash."""

from __future__ import annotations

import os
from pathlib import Path
import shutil
import subprocess
import time


LABELS = (
    "io.github.codex-ios-assistant.sender",
    "io.github.codex-ios-assistant.receiver",
)
DOMAIN = f"gui/{os.getuid()}"
AGENT_DIR = Path.home() / "Library" / "LaunchAgents"
TRASH = Path.home() / ".Trash"


def main() -> int:
    TRASH.mkdir(exist_ok=True)
    for label in LABELS:
        path = AGENT_DIR / f"{label}.plist"
        subprocess.run(["launchctl", "bootout", DOMAIN, str(path)], check=False, capture_output=True)
        if path.exists():
            destination = TRASH / f"{path.name}.{int(time.time())}"
            shutil.move(path, destination)
            print(f"Stopped {label}; moved its plist to {destination}")
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
